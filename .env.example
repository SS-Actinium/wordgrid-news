# Admin panel password (default admin123 if unset)
ADMIN_PASSWORD=admin123

# Optional separate signing secret for admin cookies
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: protect /api/news/sync for cron jobs
CRON_SECRET=change-me-cron-secret

# AI providers (also configurable in Admin → AI Keys)
# Gemini is MANDATORY — required for article hero image generation
GEMINI_API_KEY=
# Optional text providers
ANTHROPIC_API_KEY=
XAI_API_KEY=
# GROK_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GROK_MODEL=grok-2-latest

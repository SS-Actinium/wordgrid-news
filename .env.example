# World Grid — environment template
# Copy to .env.local for development. Never commit real secrets.

# --- Auth (required in production) ---
# ADMIN_PASSWORD: min 12 chars; must not be the dev default "admin123"
ADMIN_PASSWORD=
# ADMIN_SECRET: min 32 random chars; independent of password (HMAC session signing)
ADMIN_SECRET=

# --- Cron / RSS sync (required in production for /api/news/sync) ---
# Send as: Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
CRON_SECRET=

# --- Reverse proxy / client IP (rate limits) ---
# 0 = do not trust X-Forwarded-For from arbitrary clients (safe default for direct expose).
# 1 = only when the app sits behind a reverse proxy that OVERWRITES client X-Forwarded-For
#     (nginx/Caddy/Cloudflare → app). Never set 1 if untrusted clients can hit Node directly.
TRUST_PROXY=0

# --- Optional AI keys ---
# Prefer these env vars (or a secrets vault) over Admin → AI Keys / data/secrets.json.
# Env wins for ops hygiene; secrets.json is plaintext on disk if used.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://wordgrid.news

# --- Proxy / rate-limit IP (optional) ---
# Set to 1 when the app is behind a reverse proxy that sets X-Real-IP / X-Forwarded-For.
# When unset, X-Forwarded-For is ignored (spoofing-safe for direct exposure).
# TRUST_PROXY=1
